# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=floodmap
POSTGRES_USER=floodmap
POSTGRES_PASSWORD=floodmap123

MONGO_URI=mongodb://localhost:27017
MONGO_DB=drainwatch

# ─── External APIs ────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_key_here
# Free tier: https://openweathermap.org/api

# ─── Application ──────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Chennai Bounding Box ─────────────────────────────────────────────────────
CHENNAI_BBOX_NORTH=13.2500
CHENNAI_BBOX_SOUTH=12.8500
CHENNAI_BBOX_EAST=80.3300
CHENNAI_BBOX_WEST=80.1500

# ─── Model Paths ──────────────────────────────────────────────────────────────
RISK_MODEL_PATH=models/risk_scorer.pkl
YOLO_MODEL_PATH=models/yolov8n_drainwatch.pt
